(defun cgraph ()
  (format t "~%")
  (format t "~&Emacs version: ~a~%" (funcall (intern "EVAL-IN-EMACS" 'SWANK) 'emacs-version))
  (format t "~&Slime version: ~a~%" (funcall (intern "EVAL-IN-EMACS" 'SWANK) 'slime-version))
  (format t "~&SBCL version:  ~a~%" (lisp-implementation-version))

  (let* ((types-repo (format nil "~arepo/cgraph-types/" (namestring (user-homedir-pathname))))
         (concept-types-file  (format nil "~aconcept-types.lisp" types-repo))
         (relation-types-file (format nil "~arelation-types.lisp" types-repo))
         (code-path (format nil "~arepo/cgraph/" (namestring (user-homedir-pathname))))
         (cgraph-definition (format nil "~acgraph.asd" code-path)))

    (unless (asdf:component-loaded-p (asdf:find-system :cgraph nil))
      (load cgraph-definition)
      (asdf:load-system :cgraph))

    (funcall 'cg::setup-cgraph user::code-path :concept-types user::concept-types-file :relation-types user::relation-types-file)
    ;;(cg::setup-cgraph code-path :concept-types concept-types-file :relation-types relation-types-file)
    ))



